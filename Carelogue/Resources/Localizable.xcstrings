    "AI 解释仅帮助理解报告，不能替代医生的诊断。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI explanations only help you understand a report — they don't replace your doctor's diagnosis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 解释仅帮助理解报告，不能替代医生的诊断。"
          }
        }
      }
    },
